# Ollama model used for extraction (replaces the AIMaster table lookup in pms_api)
OLLAMA_MODEL=
OLLAMA_BASE_URL=https://ollama.com
# Required for ollama.com cloud models; read by the ollama client itself
OLLAMA_API_KEY=
# Seconds to wait for the model before giving up with a 504
OLLAMA_TIMEOUT_SECONDS=120
# Context window for a self-hosted Ollama; its default can silently truncate long documents
OLLAMA_NUM_CTX=
# Ask Ollama for output matching the schema as JSON Schema. Leave off for models that ignore it.
OLLAMA_STRUCTURED_OUTPUT=false

# Where submitted records go: the exact origin of the application that opens the workbench
# (for example https://app.example.com), and the message type it listens for. pms_api renders
# these into the page itself; the Flask API serves them from GET /config.
FORM_URL=
FORM_TYPE=

# Comma-separated origins allowed to call the API from a browser. Only needed when index.html
# is hosted somewhere other than this API (which serves it at /).
CORS_ORIGINS=

# Schema used for every extraction (defaults to reference_schema.json; relative paths are
# resolved against api/)
REFERENCE_SCHEMA_FILE=
# Let callers send their own schema as ref_schema. Its keys are written into the prompt, so
# leave this off unless every caller is trusted.
ALLOW_CLIENT_SCHEMA=false

# Upload and document limits
MAX_UPLOAD_MB=20
# DOCX/XLSX/PPTX files are ZIP archives; refuse ones that unpack to more than this
MAX_UNPACKED_MB=50
# Longest document text sent to the model, in characters
MAX_DOCUMENT_CHARS=60000

# Access control. With a secret set, API calls need a signed ?token= in the page URL, minted by
# the parent application (see launch_token.py). Tokens expire after WORKBENCH_LAUNCH_MAX_AGE seconds.
WORKBENCH_LAUNCH_SECRET=
WORKBENCH_LAUNCH_MAX_AGE=3600
# Per-client limit on POST /extract, e.g. "20 per minute". Empty means no limit.
EXTRACT_RATE_LIMIT=
# Rate-limit storage; use a shared store such as redis://localhost:6379 with several workers
RATELIMIT_STORAGE_URI=memory://
# Number of reverse proxies in front of the API, so client addresses come from X-Forwarded-For
TRUST_PROXY_HOPS=

# Content-Security-Policy is sent as Report-Only; set to true to enforce it
CSP_ENFORCE=false

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=5000
