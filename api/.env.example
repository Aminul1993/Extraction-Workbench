# Ollama model used for extraction (replaces the AIMaster table lookup in pms_api)
OLLAMA_MODEL=
OLLAMA_BASE_URL=https://ollama.com
# Required for ollama.com cloud models; read by the ollama client itself
OLLAMA_API_KEY=

# Comma-separated origins allowed to call the API from a browser. Only needed when index.html
# is hosted somewhere other than this API (which serves it at /).
CORS_ORIGINS=

# Schema used when a request doesn't send ref_schema (defaults to reference_schema.json)
REFERENCE_SCHEMA_FILE=

MAX_UPLOAD_MB=20
HOST=127.0.0.1
PORT=5000
